# For plain `npm run dev`/`npm run dev:mock` (not routed through Docker —
# see the root .env.example for the Makefile/docker-build-arg level vars
# these mirror). Copy this file to `.env.local` (gitignored) and fill in a
# real key to test the map/address-search on the create/edit event forms
# locally. Leave unset to develop without maps — the location field falls
# back to a plain text input.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
