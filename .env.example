API_PORT=8080

POSTGRES_HOST=db
POSTGRES_USER=joyna
POSTGRES_PASSWORD=joyna
POSTGRES_DB=joyna
POSTGRES_PORT=5432

PGADMIN_DEFAULT_EMAIL=admin@joyna.dev
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# SMTP relay used to send network-invite emails (internal/platform/mail).
# Provider-agnostic — point this at Gmail's app-password relay, SES's SMTP
# endpoint, Mailgun, Postmark, or a local dev catcher. Leave SMTP_HOST unset
# to run without email — the rest of the app still works, only
# POST /network/invite will fail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@joyna.dev

# Base URL of the frontend, used to build the registration link sent in
# invite emails.
FRONTEND_URL=http://localhost:5173

# Google Maps Platform key/Map ID for the event-location map + address
# search (frontend/components/joyna/location-field.tsx). These are baked
# into the frontend at BUILD time (Vite VITE_* vars), not read at runtime —
# see `push-frontend-image` in the Makefile and frontend/Dockerfile. Not
# really "secret" in the SMTP-password sense: they ship in the public JS
# bundle either way, protected by HTTP-referrer restriction (configured in
# Google Cloud Console), not by confidentiality. Leave unset to build
# without maps — the location field still works as a plain text input.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=

GCP_CLOUD_REGION=
GCP_CLOUD_PROJECT_ID=

GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_PASSWORD=