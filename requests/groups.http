@baseUrl = http://localhost:8080

# Requires an active session — run the Login request in auth.http first.
# REST Client shares its cookie jar across files in the same VS Code window.

### Create group
# @name createGroup
POST {{baseUrl}}/groups
Content-Type: application/json

{
  "name": "Close Friends",
  "isFavorite": true
}

### Create group — missing name, expect 400
POST {{baseUrl}}/groups
Content-Type: application/json

{
  "name": ""
}

### Delete group
DELETE {{baseUrl}}/groups/{{createGroup.response.body.$.id}}

### Delete group — already deleted / does not exist, expect 404
DELETE {{baseUrl}}/groups/{{createGroup.response.body.$.id}}

### Delete group — invalid id, expect 400
DELETE {{baseUrl}}/groups/not-a-uuid
